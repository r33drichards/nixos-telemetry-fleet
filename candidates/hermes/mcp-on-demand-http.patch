+"""Loopback stateful MCP fixture exercises the real transport and legacy handshake."""
+import asyncio
+import socket
+
+import pytest
+import pytest_asyncio
+from starlette.applications import Starlette
+from starlette.responses import JSONResponse, Response
+from starlette.routing import Route
+
+from tools import mcp_tool, mcp_tool_handlers
+from tools.mcp_tool_server_run import DemandOutcomeUncertain
+
+pytest.importorskip("mcp")
+uvicorn = pytest.importorskip("uvicorn")
+
+
+class StatefulServer:
+    def __init__(self):
+        self.methods = []
+        self.session = 0
+        self.effects = 0
+        self.drop_after_write = False
+        self.schema_revision = 1
+        self.started = asyncio.Event()
+        self.release = asyncio.Event()
+        self.pause = False
+        self.unavailable = False
+
+    async def handle(self, request):
+        if request.method != "POST":
+            self.methods.append(request.method)
+            return Response(status_code=405)
+        req = await request.json()
+        method = req["method"]
+        self.methods.append(method)
+        if self.unavailable:
+            return Response(status_code=503)
+        if method == "initialize":
+            self.session += 1
+            result = {"protocolVersion": req["params"]["protocolVersion"],
+                      "capabilities": {"tools": {}}, "serverInfo": {"name": "test", "version": "1.0"}}
+            headers = {"Mcp-Session-Id": f"test-session-{self.session}"}
+        elif request.headers.get("mcp-session-id") != f"test-session-{self.session}":
+            return Response(status_code=404)
+        elif method == "notifications/initialized":
+            return Response(status_code=202)
+        else:
+            headers = {}
+            if method == "tools/list":
+                result = {"tools": [{"name": "write", "description": "Synthetic test increment",
+                                    "inputSchema": {"type": "object", "properties": {
+                                        f"revision{self.schema_revision}": {"type": "boolean"},
+                                    }}}]}
+            elif method == "ping":
+                result = {}
+            elif method == "tools/call":
+                self.effects += 1
+                if self.pause:
+                    self.started.set()
+                    await self.release.wait()
+                if self.drop_after_write:
+                    self.drop_after_write = False
+                    return Response(status_code=503)
+                result = {"content": [{"type": "text", "text": "synthetic-ok"}]}
+            else:
+                return Response(status_code=404)
+        return JSONResponse({"jsonrpc": "2.0", "id": req["id"], "result": result}, headers=headers)
+
+
+@pytest_asyncio.fixture
+async def endpoint():
+    fake = StatefulServer()
+    app = Starlette(routes=[Route("/mcp", fake.handle, methods=["GET", "POST", "DELETE"])])
+    with socket.socket() as sock:
+        sock.bind(("127.0.0.1", 0))
+        url = f"http://127.0.0.1:{sock.getsockname()[1]}/mcp"
+        uv = uvicorn.Server(uvicorn.Config(app, lifespan="off", log_level="error"))
+        task = asyncio.create_task(uv.serve(sockets=[sock]))
+        try:
+            async with asyncio.timeout(4):
+                while not uv.started:
+                    await asyncio.sleep(0.01)
+            yield fake, url
+        finally:
+            uv.should_exit = True
+            await asyncio.wait_for(task, timeout=5)
+
+
+async def connect(url, **options):
+    server = mcp_tool.MCPServerTask("demandtest")
+    config = {"url": url, "skip_preflight": True, "connect_timeout": 3,
+              "protocol": "legacy", "sampling": {"enabled": False}, "elicitation": {"enabled": False}}
+    await asyncio.wait_for(server.start(config | options), timeout=5)
+    return server
+
+
+async def write(server):
+    async def call():
+        async with server._rpc_lock:
+            return await server.session.call_tool("write")
+    return await server._call_on_demand(call)
+
+
+@pytest.mark.asyncio
+async def test_dormant_catalog_reconnects_once_for_concurrent_calls(endpoint, monkeypatch):
+    fake, url = endpoint
+    server = await connect(url, on_demand=True, idle_timeout_seconds=0.08)
+    monkeypatch.setitem(mcp_tool._servers, "demandtest", server)
+    try:
+        await asyncio.sleep(0.2)
+        assert server.session is None
+        assert mcp_tool_handlers._make_check_fn("demandtest")()
+        assert [tool.name for tool in server._tools] == ["write"]
+        before = fake.methods.copy()
+        await asyncio.sleep(0.15)
+        assert fake.methods == before
+        fake.pause = True
+        first = asyncio.create_task(write(server))
+        await asyncio.wait_for(fake.started.wait(), timeout=3)
+        second = asyncio.create_task(write(server))
+        await asyncio.sleep(0.12)  # Past idle window; must not cancel active RPC.
+        assert not first.done()
+        fake.release.set()
+        await asyncio.wait_for(asyncio.gather(first, second), timeout=4)
+        assert fake.methods.count("initialize") == 2  # one initial and one shared reconnection
+        assert fake.effects == 2  # each caller exactly once
+    finally:
+        await server.shutdown()
+
+
+@pytest.mark.asyncio
+async def test_pre_dispatch_stale_404_recovers_once_but_failed_write_never_replays(endpoint):
+    fake, url = endpoint
+    server = await connect(url, on_demand=True)
+    try:
+        fake.session += 1  # A returned transport handle can be stale before Hermes's idle timer.
+        await write(server)
+        assert fake.methods.count("initialize") == 2
+        assert fake.effects == 1
+        fake.drop_after_write = True
+        with pytest.raises(DemandOutcomeUncertain):
+            await write(server)
+        assert fake.effects == 2
+        before = fake.methods.count("initialize")
+        await asyncio.sleep(0.12)
+        assert fake.methods.count("initialize") == before  # no unsolicited reconnection
+        await write(server)
+        assert fake.effects == 3
+        assert fake.methods.count("initialize") == before + 1
+    finally:
+        await server.shutdown()
+
+
+@pytest.mark.asyncio
+async def test_unflagged_streamable_session_retains_existing_lifecycle(endpoint):
+    _, url = endpoint
+    server = await connect(url, idle_timeout_seconds=0.04)
+    try:
+        await asyncio.sleep(0.12)
+        assert server.session is not None
+        assert not server._uses_on_demand_http()
+    finally:
+        await server.shutdown()
+
+
+@pytest.mark.asyncio
+async def test_cancelled_write_is_not_replayed(endpoint):
+    fake, url = endpoint
+    server = await connect(url, on_demand=True)
+    try:
+        fake.pause = True
+        task = asyncio.create_task(write(server))
+        await asyncio.wait_for(fake.started.wait(), timeout=3)
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+        fake.release.set()
+        await asyncio.sleep(0.12)
+        assert fake.effects == 1
+        assert fake.methods.count("initialize") == 1
+        await write(server)
+        assert fake.effects == 2
+        assert fake.methods.count("initialize") == 2
+    finally:
+        fake.release.set()
+        await server.shutdown()
+
+
+@pytest.mark.asyncio
+async def test_reconnect_rejects_old_catalog_contract_before_dispatch(endpoint, monkeypatch):
+    fake, url = endpoint
+    server = await connect(url, on_demand=True, idle_timeout_seconds=0.08)
+    monkeypatch.setitem(mcp_tool._servers, "demandtest", server)
+    monkeypatch.setattr(mcp_tool_handlers, "_trust_gate_check", lambda *args: None)
+    monkeypatch.setattr(mcp_tool_handlers, "_check_circuit_breaker", lambda name: None)
+    monkeypatch.setattr(mcp_tool_handlers, "_acquire_call_server", lambda *args: (server, None))
+    loop = asyncio.get_running_loop()
+    monkeypatch.setattr(mcp_tool_handlers._loop, "_run_on_mcp_loop",
+                        lambda call, timeout: asyncio.run_coroutine_threadsafe(call(), loop).result(timeout))
+    handler = mcp_tool_handlers._make_tool_handler("demandtest", "write", 3)
+    try:
+        await asyncio.sleep(0.2)
+        fake.schema_revision = 2
+        result = await asyncio.to_thread(handler, {})
+        assert "tool contract changed" in result
+        assert fake.effects == 0
+        result = await asyncio.to_thread(handler, {})
+        assert "synthetic-ok" in result
+        assert fake.effects == 1
+    finally:
+        await server.shutdown()
+
+
+@pytest.mark.asyncio
+async def test_first_discovery_failure_does_not_poll_and_explicit_reload_recovers(endpoint):
+    fake, url = endpoint
+    fake.unavailable = True
+    server = mcp_tool.MCPServerTask("demandtest")
+    config = {"url": url, "protocol": "legacy", "on_demand": True, "connect_timeout": 2}
+    try:
+        with pytest.raises(Exception, match="503"):
+            await asyncio.wait_for(server.start(config), timeout=3)
+        assert fake.methods == ["initialize"]
+        await asyncio.sleep(0.12)
+        assert fake.methods == ["initialize"]
+    finally:
+        await server.shutdown()
+
+    fake.unavailable = False
+    repaired = await connect(url, on_demand=True)
+    try:
+        assert [tool.name for tool in repaired._tools] == ["write"]
+        await write(repaired)
+        assert fake.effects == 1
+    finally:
+        await repaired.shutdown()
+
+
+@pytest.mark.asyncio
+async def test_changed_endpoint_identity_is_not_contacted_on_old_catalog(endpoint):
+    fake, url = endpoint
+    server = await connect(url, on_demand=True, idle_timeout_seconds=0.08)
+    try:
+        await asyncio.sleep(0.2)
+        before = fake.methods.copy()
+        server._config["url"] = url + "?another-endpoint"
+        with pytest.raises(RuntimeError, match="could not connect"):
+            await write(server)
+        assert fake.methods == before
+        assert fake.effects == 0
+    finally:
+        await server.shutdown()
