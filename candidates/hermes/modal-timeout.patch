+def _sandbox_timeout(kwargs: dict) -> int:
+    # Bound direct sandbox lifetime independently from each command timeout.
+    value = kwargs.pop("timeout", None)
+    if value is None:
+        value = os.environ.get("HERMES_MODAL_SANDBOX_TIMEOUT", "300")
+    if type(value) is str and value.isascii() and value.isdecimal():
+        value = int(value)
+    if type(value) is not int or not 1 <= value <= 300:
+        raise ValueError("Modal sandbox timeout must be an integer from 1 to 300 seconds")
+    return value
+
 
